<?xml version="1.0"?>
<project name="swmutsel" default="dist" basedir=".">
    <property name="src.dir" location="src/main/java" />
    <property name="src.resources" location="src/main/resources" />
    <property name="build.dir" location="build" />
    <property name="dist.dir" location="dist" />
    <property name="docs.dir" location="docs/api" />
    <property name="libs.dir" location="lib" />
    <property name="test.src.dir" location="src/test/java" />
    <property name="test.resources.dir" location="src/test/resources" />
    <property name="test.build.dir" location="build-test" />

    <path id="build.classpath">
        <fileset dir="${libs.dir}">
            <include name="**/*.jar" />
        </fileset>
    </path>

    <target name="clean">
        <delete dir="${build.dir}" />
        <delete dir="${test.build.dir}" />
        <delete dir="${dist.dir}" />
    </target>

    <target name="makedir">
        <mkdir dir="${build.dir}" />
        <mkdir dir="${dist.dir}" />
        <copy todir="${build.dir}">
           <fileset dir="${src.resources}" />
        </copy>
    </target>

    <target name="compile">
        <javac includeantruntime="false" srcdir="${src.dir}" destdir="${build.dir}" classpathref="build.classpath">
        </javac>
    </target>

    <target name="test" depends="makedir, compile">
        <mkdir dir="${test.build.dir}" />
        <javac includeantruntime="false" srcdir="${test.src.dir}" destdir="${test.build.dir}">
            <classpath>
                <pathelement location="${build.dir}" />
                <path refid="build.classpath" />
            </classpath>
        </javac>
        <java classname="org.junit.runner.JUnitCore" fork="true" failonerror="true">
            <arg value="swmutsel.FixAllTest" />
            <arg value="swmutsel.FitnessOptimisationTest" />
            <arg value="swmutsel.HelpTest" />
            <arg value="swmutsel.FMutSel0OptimisationTest" />
            <arg value="swmutsel.AminoAcidPseudocountTest" />
            <arg value="swmutsel.model.TransProbCalcFactoryTest" />
            <sysproperty key="test.resources" value="${test.resources.dir}" />
            <classpath>
                <pathelement location="${test.build.dir}" />
                <pathelement location="${test.resources.dir}" />
                <pathelement location="${build.dir}" />
                <path refid="build.classpath" />
            </classpath>
        </java>
    </target>

    <target name="docs" depends="compile">
        <delete dir="${docs.dir}" />
        <mkdir dir="${docs.dir}" />
        <javadoc sourcepath="${src.dir}" destdir="${docs.dir}" classpathref="build.classpath"> <!--  Overview="etc/overview.html"  -->
            <fileset dir="${src.dir}">
                <include name="**" />
                <exclude name="**/${ant.project.name}.iml"/>
            </fileset>
        </javadoc>
    </target>

    <target name="jar" depends="compile">
        <tstamp>
            <format property="timenow" pattern="yyMMddHHmm" />
        </tstamp>
        <jar destfile="${dist.dir}/${ant.project.name}.jar" basedir="${build.dir}">
            <manifest>
                <attribute name="Main-Class" value="swmutsel.Run" />
            </manifest>
            <zipgroupfileset dir="lib" includes="*.jar" excludes="junit-*.jar,hamcrest-*.jar" />
        </jar>
    </target>

    <target name="all" depends="clean, makedir, compile, jar" />

    <target name="dist" depends="makedir, compile, jar">
        <description>Build everything</description>
    </target>

</project>

